/* Main status */
"header.scope" = "TailBridge only adds a firewall exception so Tailscale works alongside Mullvad. It never connects or disconnects Mullvad.";
"status.checking.title" = "Checking Status…";
"status.checking.detail" = "Reading the state of Mullvad, Tailscale and the TailBridge helper.";
"status.on.title" = "TailBridge Is On";
"status.on.detail" = "Mullvad reports it’s connected, and TailBridge’s firewall exception for your Tailscale devices is in place. TailBridge doesn’t change where your other traffic goes. Run a connection test to check that your devices are reachable.";
"status.onNoMullvad.detail" = "TailBridge’s firewall exception is in place, but Mullvad isn’t reported as connected, so TailBridge can’t confirm that your other traffic goes through Mullvad. Check the Mullvad app, or click Disable to remove the exception.";
"status.onNoTailscale.detail" = "TailBridge’s firewall exception is in place, but Tailscale isn’t reported as running, so your devices may not be reachable. Connect Tailscale, or click Disable to remove the exception.";
"status.off.title" = "TailBridge Is Off";
"status.off.ready" = "While Mullvad is connected, it may block your Tailscale devices. Click Enable to allow them.";
"status.off.needMullvad" = "Connect Mullvad first. TailBridge doesn’t connect it for you.";
"status.off.needTailscale" = "Start Tailscale and sign in, then click Enable.";
"status.off.needDomain" = "Tailscale didn’t report your tailnet name. Make sure MagicDNS is on in the Tailscale admin console, then click Refresh.";
"status.off.needPF" = "The macOS packet filter (PF), which Mullvad uses, is turned off, so TailBridge can’t add its exception. Try reconnecting Mullvad, then click Refresh.";
"status.off.pfUnreadable" = "TailBridge can’t read the firewall state, so Enable is unavailable. This doesn’t mean the firewall is off. Click Refresh in a moment; if this stays, reinstall the helper (Administration → Install Helper…, which restarts it), then run Diagnostics.";
"status.off.needOrder" = "The firewall rules aren’t in the order TailBridge needs, so it won’t change them. Run Diagnostics and check the log.";
"status.leftovers" = "Some earlier TailBridge changes are still in place. Click Disable to remove them.";
"status.error.title" = "TailBridge Found a Problem";
"status.error.detail" = "The firewall exception doesn’t match what TailBridge expects, and the helper is cleaning it up. Click Disable, then check the log if this persists.";
"status.stale.title" = "TailBridge Needs Attention";
"status.stale.detail" = "Tailscale’s connection changed since TailBridge was enabled, so the old exception is being removed. Click Disable to clear it, then Enable again.";
"status.setup.title" = "Setup Needed";
"status.setup.detail" = "Install the TailBridge helper under Administration below before enabling.";
"status.unknown.title" = "Status Unknown";
"status.unknown.detail" = "The TailBridge helper isn’t reporting, so its firewall exception may still be in place. Click Disable to remove it. If this continues, reinstall the helper under Administration.";

